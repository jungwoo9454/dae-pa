# cp .env.example .env.local — 값은 Supabase 대시보드 > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
# 신규 프로젝트는 publishable key(sb_publishable_...) 를 쓴다. 둘 중 하나만 채우면 된다.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용 — app/api/**, lib/server/** 에서만 사용. 클라이언트 코드에서 import 금지
SUPABASE_SERVICE_ROLE_KEY=