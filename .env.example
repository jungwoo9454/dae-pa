# cp .env.example .env.local — 값은 Supabase 대시보드 > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
# 신규 프로젝트는 publishable key(sb_publishable_...) 를 쓴다. 둘 중 하나만 채우면 된다.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용 — app/api/**, lib/server/** 에서만 사용. 클라이언트 코드에서 import 금지
SUPABASE_SERVICE_ROLE_KEY=

# 토스페이먼츠 테스트 결제 (#14) — 대파페이 충전. 실제 출금 없음.
# 아래는 토스 공식 문서용 테스트 키. 본인 키는 개발자센터(사업자등록 없이 가입) > API 키에서 발급.
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_gck_docs_OaPz8L5KdmQXkzRz3y47BMw6
# 서버 전용 — app/api/** 에서만 사용. 클라이언트 코드에서 import 금지
TOSS_SECRET_KEY=test_gsk_docs_OaPz8L5KdmQXkzRz3y47BMw6

# Cloudflare R2 — 이미지 업로드(#15 영수증·아바타·공구 대표 이미지·채팅 사진)
# 서버 전용. app/api/upload, lib/server/r2.ts 에서만 쓴다 — 클라이언트는 DB 에 저장된 완성 URL 만 읽는다
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# 버킷 설정 > Public Development URL. 끝에 / 없이
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
